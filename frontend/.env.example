# Local development: leave this blank/unset. The Vite dev server proxies
# /api and /uploads to your local backend (see vite.config.js) - nothing
# below is needed to run this locally.

# Production only (e.g. deploying the frontend to Netlify while the
# backend lives elsewhere, like Render): set this to your backend's full
# public URL with /api on the end, e.g.:
# VITE_API_URL=https://your-backend-name.onrender.com/api
VITE_API_URL=
