PORT=5000

# PostgreSQL connection - use EITHER method below, not both.
#
# Method 1: local development (Postgres running on your own machine)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_library
DB_USER=postgres
DB_PASSWORD=postgre
#
# Method 2: cloud deployment (Neon, Render Postgres, Supabase, etc.) - if
# DATABASE_URL is set, it's used INSTEAD of the 5 values above, with SSL
# automatically enabled (required by Neon and most cloud providers).
# Get this from your provider's dashboard - Neon calls it "Connection string".
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Initial admin account (used only by npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@kptc.edu.et
ADMIN_PASSWORD=Admin@123

# Uploads
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=100

# Credential delivery email (Gmail) - sent automatically whenever a new
# account is created anywhere in the system (Admin -> Admin Librarian,
# Admin Librarian -> Faculty/Librarian/Staff/Student, Faculty -> Teacher,
# Librarian -> Student), containing that person's username (email) and
# password. Use a Gmail "App Password", NOT your normal Gmail password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=kombolchapoly1994@gmail.com
GMAIL_APP_PASSWORD=rwceklruyeabtugu

# OPTIONAL: exact-fidelity docx/ppt viewing via LibreOffice.
# Leave blank if "soffice" is already on your system PATH (common on Mac/Linux
# after a normal install). On Windows, LibreOffice is usually NOT added to
# PATH automatically - set this to the "program" folder inside your install,
# e.g.:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program

